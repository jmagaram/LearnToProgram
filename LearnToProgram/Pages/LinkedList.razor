@page "/linked-list"
@using System.Text.Json
@using System.Text.RegularExpressions
@using LearnToProgram.Practice
@using LearnToProgram.Practice.LinkedList
@inject IJSRuntime JS

<PageTitle>Linked List</PageTitle>

<div class="ccp">
<header class="top">
    <div>
        <h1>Linked List Practice</h1>
        <p class="intro">
            Write each method using <code>IntNode</code>. This page runs the <b>real C# compiler</b> in your
            browser. Replace the <code>// TODO</code> with your code, then press <b>Run</b>
            (or Ctrl+Enter / ⌘+Enter) to check it against the tests. Lists are shown like
            <code>[3 -&gt; 5 -&gt; 8]</code>, and <code>[]</code> is the empty list (<code>null</code>).
        </p>
        <details class="api">
            <summary>What an <code>IntNode</code> can do</summary>
            <table>
                <tbody>
                    <tr><td><code>new IntNode(5)</code></td><td>a new node holding 5, with no next node</td></tr>
                    <tr><td><code>new IntNode(5, other)</code></td><td>a new node holding 5, followed by <code>other</code></td></tr>
                    <tr><td><code>node.GetValue()</code></td><td>the number in the node</td></tr>
                    <tr><td><code>node.GetNext()</code></td><td>the next node, or <code>null</code> at the end of the list</td></tr>
                    <tr><td><code>node.SetValue(7)</code></td><td>change the number in the node</td></tr>
                    <tr><td><code>node.SetNext(other)</code></td><td>change which node comes next</td></tr>
                    <tr><td><code>node.HasNext()</code></td><td><code>true</code> if there is a next node</td></tr>
                </tbody>
            </table>
            <p>You can also call your other methods. For example, <code>Merge</code> can use <code>AddLast</code>.</p>
        </details>
        <div class="toolbar">
            <button type="button" class="primary" disabled="@(!ready || busy)" @onclick="RunAll">Run all</button>
            <span class="score" aria-live="polite">Solved: @Solved of @LinkedListProblems.All.Length@(Solved == LinkedListProblems.All.Length ? " — Perfect! Every problem is correct!" : "")</span>
            <button type="button" class="ghost" disabled="@busy" @onclick="ClearAll">Reset all problems</button>
            <div class="score-detail">
                @if (!ready)
                {
                    <span class="warming">Getting the C# compiler ready. The first time takes a few seconds…</span>
                }
                else
                {
                    @scoreDetail
                }
            </div>
        </div>
        <nav class="chips" aria-label="Jump to a problem">
            @foreach (var p in LinkedListProblems.All)
            {
                <a href="linked-list#@p.Anchor" data-status="@StatusOf(p)" title="@p.Name"
                   @onclick:preventDefault @onclick="() => ScrollTo(p)">@p.Id</a>
            }
        </nav>
    </div>
</header>

<div class="problems">
    @foreach (var p in LinkedListProblems.All)
    {
        var card = cards[p.Id];
        <article class="card" id="@p.Anchor" data-status="@StatusOf(p)">
            <div class="card-head">
                <span class="num">@(p.Id).</span>
                <h3>@p.Question</h3>
                <span class="badge">@BadgeOf(p)</span>
            </div>
            <div class="code">
                <div>@Highlight(p.Signature)</div>
                <div>{</div>
                <textarea class="answer" rows="@RowsFor(card.Code)" spellcheck="false" autocomplete="off"
                          autocapitalize="off" aria-label="Code for problem @p.Id"
                          value="@card.Code" @oninput="e => OnEdit(p, e)"></textarea>
                <div>}</div>
            </div>
            <div class="actions">
                <button type="button" class="run" disabled="@(!ready || busy)" @onclick="() => RunOne(p)">Run</button>
                <span class="hint">@p.TestCount tests</span>
                @if (card.Elapsed is not null)
                {
                    <span class="hint">· compiled and ran in @card.Elapsed</span>
                }
            </div>
            @if (card.Result is { } r)
            {
                <div class="result @(card.Stale ? "stale" : "")" aria-live="polite">
                    @if (r.Outcome == Outcome.NotDone)
                    {
                        <p class="summary">Not done yet. Replace <code>// TODO</code> with your code.</p>
                    }
                    else if (r.Outcome == Outcome.CompileError)
                    {
                        <div class="error-box">
                            <p class="title">This won't compile</p>
                            @foreach (var m in r.Errors)
                            {
                                <div class="compiler-msg">
                                    <code class="where">@(m.Line is null ? m.Id : $"Line {m.Line}, col {m.Column}: {m.Id}")</code>
                                    <span>@m.Message</span>
                                    @if (m.Hint is not null)
                                    {
                                        <div class="tip">Tip: @m.Hint</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="summary @(r.Outcome == Outcome.Pass ? "pass" : "fail")">
                            @(r.Outcome == Outcome.Pass ? $"All {r.Rows.Count} correct!" : $"{r.Correct} of {r.Rows.Count} correct. Keep trying.")
                        </p>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr><th>test</th><th>your code</th><th>expected</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in r.Rows)
                                    {
                                        <tr class="@(row.Ok ? "" : "wrong-row")">
                                            <td>@row.Call</td>
                                            <td>@row.Got</td>
                                            <td>@row.Expected</td>
                                            <td class="@(row.Ok ? "ok" : "wrong")">@(row.Ok ? "✓ OK" : "✗ WRONG")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @foreach (var tip in TipsFor(r))
                        {
                            <p class="tip-line">Tip: @tip</p>
                        }
                    }
                </div>
            }
        </article>
    }
</div>

<footer>
    Your code is compiled by Roslyn, the same C# compiler that .NET uses, running in your browser with
    WebAssembly. Nothing is sent to a server. Your code is saved in this browser.
    A loop that runs more than a million times is stopped and reported as "never ends".
</footer>
</div>

@code {
    const string StorageKey = "learntoprogram-linked-list-v1";
    const int MinRows = 8;

    sealed class CardState
    {
        public string Code = "";
        public LinkedListResult? Result;
        public bool Stale;
        public string? Elapsed;
    }

    readonly LinkedListRunner runner = new();
    readonly Dictionary<string, CardState> cards =
        LinkedListProblems.All.ToDictionary(p => p.Id, p => new CardState { Code = p.StartingCode });
    bool ready;
    bool busy;
    string scoreDetail = "";

    int Solved => cards.Values.Count(c => c.Result?.Outcome == Outcome.Pass);

    // Room to write several lines, growing as the student types.
    static int RowsFor(string code) => Math.Max(MinRows, code.Split('\n').Length + 1);

    static readonly Regex Keywords = new(@"\b(public|static|int|bool|void)\b");

    static MarkupString Highlight(string signature) =>
        new(Keywords.Replace(System.Net.WebUtility.HtmlEncode(signature), "<span class=\"kw\">$1</span>"));

    string StatusOf(LinkedListProblem p) => cards[p.Id].Result?.Outcome switch
    {
        Outcome.Pass => "pass",
        Outcome.Fail => "fail",
        Outcome.CompileError => "error",
        _ => "idle",
    };

    string BadgeOf(LinkedListProblem p) => cards[p.Id].Result switch
    {
        null => p.IsExample ? "example" : "",
        { Outcome: Outcome.Pass } => "✓ solved",
        { Outcome: Outcome.Fail } r => $"{r.Correct} of {r.Rows.Count}",
        { Outcome: Outcome.CompileError } => "won't compile",
        _ => "not done yet",
    };

    // Plain-language tips for the ways linked-list code usually goes wrong.
    static IEnumerable<string> TipsFor(LinkedListResult r)
    {
        var got = r.Rows.Where(x => !x.Ok).Select(x => x.Got).ToList();
        if (got.Any(g => g.Contains("NullReferenceException")))
            yield return "Your code used a node that was null. Check what happens with the empty list, and at the end of the list.";
        if (got.Any(g => g.StartsWith("never ends: a loop")))
            yield return "A loop never stopped. Inside the loop, move to the next node with lst = lst.GetNext();";
        if (got.Any(g => g.StartsWith("never ends: a method")))
            yield return "Your method keeps calling itself. Make sure it stops when it reaches the end of the list.";
        if (got.Any(g => g.Contains("... never ends]")))
            yield return "Your list now loops back on itself. Check which node each SetNext points to.";
        if (got.Any(g => g.Contains("NotImplementedException")))
            yield return "This calls one of your other methods that isn't done yet or doesn't compile.";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("practiceStorage.load", StorageKey);
            var saved = json is null ? null : JsonSerializer.Deserialize<Dictionary<string, string>>(json);
            if (saved is not null)
            {
                foreach (var (id, code) in saved)
                {
                    if (cards.TryGetValue(id, out var card)) card.Code = code;
                }
            }
        }
        catch (Exception) { /* storage unavailable: start fresh */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.Delay(50); // let the page paint before the compiler start-up blocks the thread
        runner.WarmUp();
        ready = true;
        StateHasChanged();
    }

    void OnEdit(LinkedListProblem p, ChangeEventArgs e)
    {
        var card = cards[p.Id];
        card.Code = e.Value?.ToString() ?? "";
        card.Stale = true;
        Save();
    }

    async Task RunOne(LinkedListProblem p)
    {
        busy = true;
        await Task.Delay(1); // show the disabled buttons before compiling
        // Compile every answer, so this one can call the student's other methods.
        Apply(runner.Run(AllAnswers(), new[] { p.Id }), runner.LastElapsed);
        busy = false;
    }

    async Task RunAll()
    {
        busy = true;
        scoreDetail = "Compiling…";
        StateHasChanged();
        await Task.Delay(1);
        Apply(runner.Run(AllAnswers()), null);
        var needWork = LinkedListProblems.All.Where(p => StatusOf(p) is "fail" or "error").Select(p => p.Id).ToList();
        var notDone = LinkedListProblems.All.Where(p => StatusOf(p) == "idle").Select(p => p.Id).ToList();
        var parts = new List<string>();
        if (needWork.Count > 0) parts.Add("Needs work: " + string.Join(", ", needWork));
        if (notDone.Count > 0) parts.Add("Not done yet: " + string.Join(", ", notDone));
        parts.Add($"compiled and ran in {Seconds(runner.LastElapsed)}");
        scoreDetail = string.Join("  ·  ", parts);
        busy = false;
    }

    List<(LinkedListProblem, string)> AllAnswers() => LinkedListProblems.All.Select(p => (p, cards[p.Id].Code)).ToList();

    void Apply(Dictionary<string, LinkedListResult> results, TimeSpan? elapsed)
    {
        foreach (var (id, result) in results)
        {
            var card = cards[id];
            card.Result = result;
            card.Stale = false;
            card.Elapsed = elapsed is null ? null : Seconds(elapsed.Value);
        }
    }

    static string Seconds(TimeSpan t) => t.TotalSeconds.ToString("0.00") + " s";

    async Task ClearAll()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Erase all of your code on this page and start over?")) return;
        foreach (var p in LinkedListProblems.All)
        {
            var card = cards[p.Id];
            card.Code = p.StartingCode;
            card.Result = null;
            card.Stale = false;
            card.Elapsed = null;
        }
        scoreDetail = "";
        Save();
    }

    void Save()
    {
        var json = JsonSerializer.Serialize(cards.ToDictionary(c => c.Key, c => c.Value.Code));
        _ = JS.InvokeVoidAsync("practiceStorage.save", StorageKey, json).AsTask();
    }

    async Task ScrollTo(LinkedListProblem p) => await JS.InvokeVoidAsync("practiceScrollTo", p.Anchor);
}
