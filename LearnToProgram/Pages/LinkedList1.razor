@page "/linked-list-1"
@page "/linked-list-1/{Number:int}"
@using LearnToProgram.Practice.LinkedList

<ReadPage Levels="LinkedListReading.Levels" Questions="LinkedListReading.All" Number="Number"
          Title="Linked List 1" Href="linked-list-1" StorageKey="linked-list-reading-v1">
    <Api>
        <details class="api" open>
            <summary>What an <code>IntNode</code> can do</summary>
            <table>
                <tbody>
                    <tr><td><code>new IntNode(5)</code></td><td>a new node holding 5, with no next node</td></tr>
                    <tr><td><code>new IntNode(5, other)</code></td><td>a new node holding 5, followed by <code>other</code></td></tr>
                    <tr><td><code>node.GetValue()</code></td><td>the number in the node</td></tr>
                    <tr><td><code>node.GetNext()</code></td><td>the next node, or <code>null</code> at the end of the list</td></tr>
                    <tr><td><code>node.SetValue(7)</code></td><td>change the number in the node</td></tr>
                    <tr><td><code>node.SetNext(other)</code></td><td>change which node comes next</td></tr>
                    <tr><td><code>node.HasNext()</code></td><td><code>true</code> if there is a next node</td></tr>
                </tbody>
            </table>
        </details>
    </Api>
</ReadPage>

@code {
    [Parameter] public int? Number { get; set; }
}
